{
  "name": "harbor-desktop",
  "version": "0.0.0-private",
  "private": true,
  "description": "Harbor native UiSpec schema tooling",
  "engines": {
    "node": ">=27.0.0-alpha.0.0.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "build:ui-schema": "node tools/build_ui_schema_bundle.js",
    "build:island": "npm --prefix frontend/react run build",
    "build": "node frontend/build.js",
    "build:all": "npm run build:island && npm run build",
    "diff:all": "npm --prefix server run diff:all",
    "smoke:island": "node tools/smoke_harbor_island.js",
    "perf:confirm": "node tools/perf_confirm_path.js"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
