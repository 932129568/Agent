# 构建产物（源码构建生成）
node_modules/
build/
# M2 真编译产物（.obj/.exe/.cso/.asm）只落本地，不入库
native/build/
# 上面那条注释承诺了 .obj/.exe/.cso/.asm 不入库，但此前只有注释、没有规则 ——
# 于是 shaders/tiers/*.cso / *.asm 一度处于「可被 git add」状态（40 KB 编译产物）。
# 补上真实规则，让注释与行为一致。仓库里这四类文件当前 0 个已跟踪，故不会误伤。
*.obj
*.cso
*.asm
# 注意：exe 的排除见下方「发行分发」条（只排 dist/ 下的安装包），
# 这里不写全局 *.exe，避免与那条的意图重复表达。
*.pyc
__pycache__/
.pytest_cache/

# 运行数据（用户本机 ~/.glm-chat/，绝不入库）
.glm-chat/
*.log
logs/
audit_log.jsonl

# 测试残留
.realtest_*
.realtest_shots/

# IDE / 系统
.workbuddy/
.workbuddy-ai/
.vscode/
.idea/
Thumbs.db
desktop.ini

# 旧版构建产物（legacy 源码保留供契约测试，其 html 产物不入库）
glm-chat.v1.0.0.html

# 敏感配置（双保险：即使误放也不上传）
mcp_servers.json
webdav.json
config.json
*.dpapi
push_exe_tmp.py

# 发行分发走 GitHub Release assets，git 不跟踪 exe（2026-10-21 用户要求）
dist/*.exe
build/

# P0-4 T04：Electron 打包产物输出（electron-builder NSIS，dist/ 恒冻结）
dist-electron/
# R89 终局：分卷输出目录（「只增不删」不覆盖旧安装包 → 每轮换目录名），同样不入库
dist-electron-*/

# 测试/QA 临时产物（2026-10-30 快照决策：outputs/ 下新增文件不入库；历史已跟踪文件不受影响）
outputs/

# 历史波次备份目录（git 自身即版本控制，备份冗余不入库）
deliverables/wave-backups/

# AI 工具本机状态目录
.ai-memory/
.mimosa/

# ============================================================
# R100 仓库收敛（2026-11-19）：开发过程资料/QA 证据/历史文档不入库
# 本地磁盘全部保留（只增不删），只是不纳入版本控制
# ============================================================

